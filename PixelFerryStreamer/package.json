{
  "name": "pixelferry-streamer",
  "productName": "PixelFerry Streamer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "build": "esbuild src/host-renderer.js --bundle --platform=browser --outfile=dist/host-renderer.js && esbuild src/viewer.js --bundle --platform=browser --outfile=dist/viewer.js",
    "start": "npm run build && electron src/main.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/quality-profiles.js && node --check src/protocol.js && node --check src/webrtc-stats.js && node --check src/adaptive-quality-controller.js && node --check src/quality-transition-coordinator.js && npm test",
    "package:mac": "npm run build && node scripts/package-macos.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pixelmatch": "^7.1.0",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "@electron/universal": "2.0.1",
    "electron": "43.1.1",
    "esbuild": "^0.25.6"
  }
}
